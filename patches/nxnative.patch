+// ---- Squadala!'s save exports (its module finds them by name, dlsym RTLD_DEFAULT; Longshot's patches 0008 and 0025) ----
+// The host's save for its guests: a guest of another player's session plays from <its save folder>-coop, into which the host's save comes; the module
+// decides that when it joins, before a save is loaded (hos_coop_fs_save_root, hos_coop_fs_save_remount). Here the account save is a transaction (a work
+// copy swapped in at each Commit), so the move makes the new folder's own transaction: its work copy is cloned and every name of that save (the device
+// save too, when it is the same) reads and writes there from then on; what the old work copy held uncommitted is dropped, as nothing of it was saved.
+// Refused while the game has a file of that save open (its handle would point into the dropped copy).
+// And the slot the game plays (patch 0025): the folder (<save root>/slot_NN) whose progress.sav it opened last on the account save, for reading or
+// writing, and a count of those opens, so the host sends the slot its game loaded, not the newest file on disk. Named as in the committed folder.
+static char g_coop_slot[1024]; static unsigned g_coop_slot_opens; static int g_coop_slot_write;
+static int coop_save_mount_locked(void) {   // its transaction's entry, or -1 (g_lock held)
+    if (!g_coop_save_mount[0]) return -1;
+    for (int i = 0; i < g_nmnt; i++) if (mnt_named(&g_mnt[i], g_coop_save_mount)) return g_mnt[i].txn_root >= 0 ? g_mnt[i].txn_root : -1;
+    return -1;
+}
+__attribute__((visibility("default"))) int hos_coop_fs_save_root(char *out, size_t cap) {
+    if (!out || !cap) return 0;
+    pthread_mutex_lock(&g_lock);
+    int i = coop_save_mount_locked();
+    if (i >= 0) strlcpy(out, g_mnt[i].commit, cap);
+    pthread_mutex_unlock(&g_lock);
+    return i >= 0;
+}
+__attribute__((visibility("default"))) int hos_coop_fs_save_remount(const char *root) {
+    char dir[1024], work[1100], neu[1100], old_work[1024];
+    if (!root || !*root || strlen(root) >= sizeof dir) return 0;
+    strlcpy(dir, root, sizeof dir); size_t L = strlen(dir); while (L > 1 && dir[L - 1] == '/') dir[--L] = 0;
+    for (char *q = dir + 1; *q; q++) if (*q == '/') { *q = 0; mkdir(dir, 0755); *q = '/'; }   // (mkdir -p)
+    mkdir(dir, 0755);
+    pthread_once(&g_txn_lock_once, txn_locks_init);
+    PATH_LOCK(); pthread_mutex_lock(&g_lock);
+    int i = coop_save_mount_locked();
+    if (i < 0) { pthread_mutex_unlock(&g_lock); LOG("[RED] Squadala!: the account save is not mounted as a transaction: not moved to %s", dir); return 0; }
+    if (!strcmp(g_mnt[i].commit, dir)) { pthread_mutex_unlock(&g_lock); return 1; }
+    int open_n = 0; for (int k = 0; k < 65536; k++) open_n += atomic_load(&g_ftxn[k]) == (uint16_t)(i + 1);
+    if (open_n) { pthread_mutex_unlock(&g_lock); LOG("[RED] Squadala!: the account save has %d file(s) open: not moved to %s now", open_n, dir); return 0; }
+    pthread_rwlock_wrlock(&g_txn_lock[i]);
+    snprintf(work, sizeof work, "%s.work", dir); snprintf(neu, sizeof neu, "%s.new", dir);
+    save_old_names(dir, dir);
+    const char *why = NULL;
+    if (!access(work, F_OK) && rm_tree(work)) why = "cannot clear its work directory left over from last time";
+    else if (!access(neu, F_OK) && rm_tree(neu)) why = "cannot clear its .new left over from last time";
+    else if (clonefile(dir, work, 0)) why = "cloning its work directory failed";
+    if (why) { pthread_rwlock_unlock(&g_txn_lock[i]); pthread_mutex_unlock(&g_lock); LOG("[RED] Squadala!: the account save not moved to %s: %s (errno=%d)", dir, why, errno); return 0; }
+    strlcpy(old_work, g_mnt[i].dir, sizeof old_work);
+    char was[1024]; strlcpy(was, g_mnt[i].commit, sizeof was);
+    for (int k = 0; k < g_nmnt; k++) if (g_mnt[k].txn_root == i) { strlcpy(g_mnt[k].commit, dir, sizeof g_mnt[0].commit); strlcpy(g_mnt[k].dir, work, sizeof g_mnt[0].dir); }
+    atomic_store(&g_mnt[i].poison, 0); atomic_store(&g_mnt[i].first_write_ns, 0);
+    g_coop_slot[0] = 0;
+    pthread_rwlock_unlock(&g_txn_lock[i]);
+    pthread_mutex_unlock(&g_lock);
+    if (strcmp(old_work, work)) rm_tree(old_work);
+    LOG("fs: Squadala! moved the account save (%s:) from %s to %s (its own transaction, work directory %s)", g_coop_save_mount, was, dir, work);
