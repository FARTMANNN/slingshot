+__attribute__((visibility("default"))) unsigned hos_coop_fs_save_slot_opened(char *out, size_t cap, int *write) {
+    pthread_mutex_lock(&g_lock);
+    unsigned n = g_coop_slot_opens;
+    if (out && cap) strlcpy(out, g_coop_slot, cap);
+    if (write) *write = g_coop_slot_write;
+    pthread_mutex_unlock(&g_lock);
+    return n;
+}
+// h_fs_OpenFile: an open of progress.sav on the account save (its host path in the work copy, named in the committed folder)
+static void coop_note_slot_open(const char *path, const char *hp, int write) {
+    static const char kProgress[] = "progress.sav";
+    size_t k = sizeof kProgress - 1, n = strlen(hp);
+    const char *c = strstr(path, ":/");
+    if (!c || n <= k + 1 || strcasecmp(hp + n - k, kProgress) || hp[n - k - 1] != '/') return;
+    pthread_mutex_lock(&g_lock);
+    int i = coop_save_mount_locked();
+    size_t m = strlen(g_coop_save_mount), wl = i >= 0 ? strlen(g_mnt[i].dir) : 0;
+    if (i >= 0 && m == (size_t)(c - path) && !strncmp(g_coop_save_mount, path, m) && !strncmp(hp, g_mnt[i].dir, wl) && hp[wl] == '/') {
